# Copy to airflow/local.env (your own clone) or ~/.pdflow/local.env (a user of a SHARED install;
# bin/pdflow-user-setup.sh writes it for you) to override the per-user defaults of env.sh.
# Everything here is optional. ~/.pdflow/local.env wins over airflow/local.env.

# UI port (default: 20000 + uid % 20000). Log servers use the next two ports unless set below.
#export AIRFLOW_PORT=21234
#export AIRFLOW__LOGGING__WORKER_LOG_SERVER_PORT=21235
#export AIRFLOW__LOGGING__TRIGGER_LOG_SERVER_PORT=21236

# Metadata DB folder on the Airflow host's LOCAL disk (never NFS). Use a different one for each
# copy if one person runs two copies on the same host.
#export AF_DB_DIR=/var/tmp/${USER}_pdflow_airflow_db

# Reuse an existing Airflow venv instead of building one with setup.sh (saves ~1 GB / minutes).
#export VENV=/path/to/pd_flow_airflow/airflow/venv

# Instance dir = AIRFLOW_HOME: airflow.cfg (secrets), task logs, admin password, stop.sh flag. Default:
# <checkout>/airflow/home. MUST differ per running Airflow -- set it when the checkout is shared, or when
# you start a second Airflow from the same checkout on another host.
#export PDFLOW_INSTANCE=$HOME/.pdflow/home

# Open the UI to other machines (SHARING.md way B, demo only -- every job still runs as YOU):
#export AIRFLOW__API__HOST=0.0.0.0
#export AIRFLOW__API__BASE_URL=http://$(hostname -f):$AIRFLOW_PORT
#export AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS="admin:admin,alice:viewer"

# The host your Airflow runs on -- ui-tunnel.sh (on a gateway) forwards 127.0.0.1:<port> to it:
#export PDFLOW_AIRFLOW_HOST=mipscs85
