# Copy to airflow/local.env (git-ignored) to override the per-user defaults of env.sh.
# Everything here is optional.

# UI port (default: 20000 + uid % 20000). Log servers use the next two ports unless set below.
#export AIRFLOW_PORT=21234
#export AIRFLOW__LOGGING__WORKER_LOG_SERVER_PORT=21235
#export AIRFLOW__LOGGING__TRIGGER_LOG_SERVER_PORT=21236

# Metadata DB folder on the Airflow host's LOCAL disk (never NFS). Use a different one for each
# copy if one person runs two copies on the same host.
#export AF_DB_DIR=/var/tmp/${USER}_pdflow_airflow_db

# Reuse an existing Airflow venv instead of building one with setup.sh (saves ~1 GB / minutes).
#export VENV=/path/to/pd_flow_airflow/airflow/venv
